<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\desktop-loudness-meter.ico</ApplicationIcon>
    <AssemblyName>uMeter</AssemblyName>
    <Product>uMeter</Product>
    <Company>Campfireman Studio</Company>
    <Authors>Campfireman Studio</Authors>
    <Description>Per-source desktop loudness meter with WASAPI and VST3 sender support.</Description>
    <Version>2.3.4</Version>
    <AssemblyVersion>2.3.4.0</AssemblyVersion>
    <FileVersion>2.3.4.0</FileVersion>
    <InformationalVersion>2.3.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopLoudnessMeter.Protocol\DesktopLoudnessMeter.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\desktop-loudness-meter.ico" />
    <Resource Include="Assets\desktop-loudness-meter-tray.ico" />
    <Resource Include="Assets\desktop-loudness-meter.png" />
    <Resource Include="Assets\desktop-loudness-meter-tray.png" />
  </ItemGroup>

  <PropertyGroup>
    <WebFrontendProjectDir>..\DesktopLoudnessMeter.Web</WebFrontendProjectDir>
    <WebFrontendDistDir>$(WebFrontendProjectDir)\dist</WebFrontendDistDir>
  </PropertyGroup>

  <Target Name="BuildWebFrontend" BeforeTargets="BeforeBuild" Condition="Exists('$(WebFrontendProjectDir)\package.json')">
    <Exec WorkingDirectory="$(WebFrontendProjectDir)" Command="npm ci" Condition="!Exists('$(WebFrontendProjectDir)\node_modules')" />
    <Exec WorkingDirectory="$(WebFrontendProjectDir)" Command="npm run build" />
    <ItemGroup>
      <_WebFrontendDist Include="$(WebFrontendDistDir)\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)Web" Condition="Exists('$(OutDir)Web')" />
    <MakeDir Directories="$(OutDir)Web" />
    <Copy SourceFiles="@(_WebFrontendDist)"
          DestinationFiles="@(_WebFrontendDist->'$(OutDir)Web\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWebFrontendToPublishDirectory"
          AfterTargets="Publish"
          DependsOnTargets="BuildWebFrontend"
          Condition="'$(PublishDir)' != '' And Exists('$(WebFrontendDistDir)\index.html')">
    <ItemGroup>
      <_WebFrontendPublishDist Include="$(WebFrontendDistDir)\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)Web" Condition="Exists('$(PublishDir)Web')" />
    <MakeDir Directories="$(PublishDir)Web" />
    <Copy SourceFiles="@(_WebFrontendPublishDist)"
          DestinationFiles="@(_WebFrontendPublishDist->'$(PublishDir)Web\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="..\DesktopLoudnessMeter.Native\DesktopLoudnessMeter.Native.targets" />

</Project>
