<Window x:Class="DesktopLoudnessMeter.App.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Settings"
        Icon="Assets/desktop-loudness-meter.ico"
        Width="360"
        Height="228"
        MinWidth="340"
        MinHeight="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppChromeBrush}"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,0,8,0"
                    Background="{DynamicResource AppChromeBrush}"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="Global Settings" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Events and output" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ChromeIconButton}"
                            Click="CloseButton_OnClick"
                            Content="X"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="11"
                               Text="Maximum event entries" />
                    <TextBox Grid.Column="1"
                             Height="26"
                             MinHeight="26"
                             Padding="4,0"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource NamingTextEditor}"
                             GotKeyboardFocus="SettingsTextBox_OnGotKeyboardFocus"
                             ToolTip="Stored recent-event history size. Valid range: 1 to 200."
                             Text="{Binding MaxRecentEventEntriesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="11"
                               Text="Event output folder" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border MinHeight="26"
                                Padding="8,4"
                                Background="{DynamicResource PanelAltBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11"
                                       Text="{Binding EventOutputFolderDisplayText}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button Grid.Column="2"
                                MinWidth="72"
                                Height="26"
                                Command="{Binding SelectEventOutputFolderCommand}"
                                Content="Browse" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1"
                            Width="72"
                            Height="28"
                            Click="CloseButton_OnClick"
                            Content="Close" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
