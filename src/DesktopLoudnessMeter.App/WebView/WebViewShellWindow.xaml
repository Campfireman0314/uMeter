<Window x:Class="DesktopLoudnessMeter.App.WebView.WebViewShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="uMeter"
        Icon="../Assets/desktop-loudness-meter.ico"
        Width="460"
        Height="860"
        MinWidth="380"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#171B22">
    <Grid>
        <wv2:WebView2 x:Name="ShellWebView"
                      Visibility="Collapsed" />
        <Border x:Name="StatusPanel"
                Margin="24"
                Padding="18"
                MaxWidth="680"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="#CBD5DC"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E252C"
                           Text="uMeter WebView" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           Foreground="#5F6F7A"
                           TextWrapping="Wrap"
                           Text="Initializing WebView2 shell..." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
