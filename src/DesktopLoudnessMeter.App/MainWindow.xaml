                                    <controls:SpectrumRollView SpectrumBuckets="{Binding SelectedDetailSession.SpectrumBuckets, Mode=OneWay}"
                                                               IsActive="{Binding IsInlineSpectrumVisible, Mode=OneWay}"
                                                               PlotTick="{Binding SelectedDetailSession.SpectrumPlotTick, Mode=OneWay}"
                                                               DisplayFloorDb="{Binding SpectrumDisplayFloorDb, Mode=OneWay}"
                                                               DisplayCeilingDb="{Binding SpectrumDisplayCeilingDb, Mode=OneWay}">
                                        <controls:SpectrumRollView.Style>
                                            <Style TargetType="controls:SpectrumRollView">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetailSession.IsOverallSpectrumVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SpectrumRollView.Style>
                                    </controls:SpectrumRollView>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetailSession.IsChannelSpectrumVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="185" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="185" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" Text="L" />
                                        <controls:SpectrumRollView Grid.Row="1"
                                                                   SpectrumBuckets="{Binding SelectedDetailSession.LeftSpectrumBuckets, Mode=OneWay}"
                                                                   IsActive="{Binding IsInlineSpectrumVisible, Mode=OneWay}"
                                                                   PlotTick="{Binding SelectedDetailSession.SpectrumPlotTick, Mode=OneWay}"
                                                                   DisplayFloorDb="{Binding SpectrumDisplayFloorDb, Mode=OneWay}"
                                                                   DisplayCeilingDb="{Binding SpectrumDisplayCeilingDb, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" Text="R" />
                                        <controls:SpectrumRollView Grid.Row="3"
                                                                   SpectrumBuckets="{Binding SelectedDetailSession.RightSpectrumBuckets, Mode=OneWay}"
                                                                   IsActive="{Binding IsInlineSpectrumVisible, Mode=OneWay}"
                                                                   PlotTick="{Binding SelectedDetailSession.SpectrumPlotTick, Mode=OneWay}"
                                                                   DisplayFloorDb="{Binding SpectrumDisplayFloorDb, Mode=OneWay}"
                                                                   DisplayCeilingDb="{Binding SpectrumDisplayCeilingDb, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <controls:VerticalResizeThumb TargetElement="{Binding ElementName=InlineSpectrumOnlyPanel}">
                            <controls:VerticalResizeThumb.Style>
                                <Style BasedOn="{StaticResource {x:Type controls:VerticalResizeThumb}}" TargetType="controls:VerticalResizeThumb">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInlineSpectrumVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:VerticalResizeThumb.Style>
                        </controls:VerticalResizeThumb>
                        <Border Style="{StaticResource DetailModuleDropAfterHint}">
                            <Border Height="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="1" />
                        </Border>
                    </StackPanel>
                </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="0,10,0,0"
                        Background="#809199A3"
                        CornerRadius="6"
                        IsHitTestVisible="True"
                        Visibility="{Binding SelectedDetailSession.IsInstanceMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="18,10"
                            Background="#D020252D"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Instance not found" />
                            <Button Margin="0,10,0,0"
                                    MinWidth="112"
                                    Height="28"
                                    Click="SwitchDetailButton_OnClick"
                                    Content="Switch to...">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.DetailSwitchTargets, RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="{x:Type MenuItem}"
                                                   BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding DisplayTitle}" />
                                                <Setter Property="ToolTip" Value="{Binding SourceIdentityText}" />
                                                <Setter Property="Command"
                                                        Value="{Binding PlacementTarget.DataContext.SwitchDetailSessionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>

                <Button Grid.Row="2"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Right"
                        MinWidth="82"
                        Height="28"
                        Command="{Binding SelectedDetailSession.ResetCommand}"
                        Content="Reset" />
            </Grid>
        </Grid>
    </Border>
</Window>
