<Window x:Class="DesktopLoudnessMeter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLoudnessMeter.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:DesktopLoudnessMeter.App.ViewModels"
        mc:Ignorable="d"
        Title="uMeter"
        Icon="Assets/desktop-loudness-meter.ico"
        Width="520"
        Height="860"
        MinWidth="480"
        MinHeight="700"
        Topmost="{Binding IsAlwaysOnTop, Mode=OneWay}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppChromeBrush}"
        ShowInTaskbar="True"
        d:DataContext="{d:DesignInstance}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,0,8,0"
                    Background="{DynamicResource AppChromeBrush}"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="uMeter" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="WASAPI / VST3 source metering" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="GameButton"
                            Style="{StaticResource ChromeIconButton}"
                            Click="GameButton_OnClick"
                            AutomationProperties.Name="Signal Shuffle"
                            ToolTip="Signal Shuffle">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="20" Height="16">
                                <Path Data="M 6 4 L 14 4 C 16.7 4 18.4 6.1 18.8 9.1 L 19.4 13.1 C 19.7 15.2 17.2 16.3 15.9 14.6 L 13.9 12 L 6.1 12 L 4.1 14.6 C 2.8 16.3 0.3 15.2 0.6 13.1 L 1.2 9.1 C 1.6 6.1 3.3 4 6 4 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource SubtleTextBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M 4.2 8 L 8.2 8 M 6.2 6 L 6.2 10"
                                      Stroke="{DynamicResource SubtleTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" />
                                <Ellipse Canvas.Left="13" Canvas.Top="6.4" Width="1.8" Height="1.8"
                                         Fill="{DynamicResource SubtleTextBrush}" />
                                <Ellipse Canvas.Left="15.3" Canvas.Top="8.7" Width="1.8" Height="1.8"
                                         Fill="{DynamicResource SubtleTextBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource ChromeIconButton}"
                            Click="ThemeButton_OnClick"
                            AutomationProperties.Name="Theme"
                            ToolTip="{Binding SelectedThemeName, StringFormat=Theme: {0}}">
                        <Viewbox Width="16"
                                 Height="16">
                            <Path Data="M 7 3 L 10 3 C 10.4 4 11.1 4.6 12 4.9 L 14.8 3.9 L 17 7.5 L 14.5 9 L 13.4 7.8 L 13.4 17 L 3.6 17 L 3.6 7.8 L 2.5 9 L 0 7.5 L 2.2 3.9 L 5 4.9 C 5.9 4.6 6.6 4 7 3 Z"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource SubtleTextBrush}"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform" />
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.ThemeOptions, RelativeSource={RelativeSource Self}}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="{x:Type MenuItem}"
                                           BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding DisplayName}" />
                                        <Setter Property="MinWidth" Value="132" />
                                        <Setter Property="Command"
                                                Value="{Binding PlacementTarget.DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Grid.Column="3"
                            x:Name="GlobalSettingsButton"
                            Style="{StaticResource ChromeIconButton}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Content="&#xE713;"
                            Click="GlobalSettingsButton_OnClick"
                            AutomationProperties.Name="Global settings"
                            ToolTip="Global settings" />

                    <Button Grid.Column="4"
                            Style="{StaticResource ChromeIconButton}"
                            Click="MinimizeButton_OnClick"
                            Content="-"
                            AutomationProperties.Name="Hide to tray"
                            ToolTip="Hide to tray" />

                    <Button Grid.Column="5"
                            Style="{StaticResource ChromeIconButton}"
                            Click="CloseButton_OnClick"
                            Content="X"
                            AutomationProperties.Name="Close"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailViewVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="12,10,12,6"
                        Padding="10,7"
                        Background="{DynamicResource PanelAltBrush}"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusText, FallbackValue=Waiting for audio sources}" />
                        <TextBlock Grid.Column="1"
                                   Foreground="{DynamicResource WarmBrush}"
                                   FontSize="11"
                                   Text="{Binding RefreshLabel, FallbackValue=33 ms}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="12,0,12,8"
                        Padding="10"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Mode" />
                                <ComboBox Height="26"
                                          AutomationProperties.Name="Mode"
                                          ItemsSource="{Binding DisplayModeOptions}"
                                          SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="True Peak" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding TruePeakEnabled, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="2"
                                              MinWidth="148"
                                              Height="26"
                                              AutomationProperties.Name="True Peak"
                                              ItemsSource="{Binding TruePeakOversamplingOptions}"
                                              SelectedItem="{Binding SelectedTruePeakOversampling, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="4"
                                        MinWidth="84">
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Performance" />
                                <CheckBox Height="26"
                                          VerticalContentAlignment="Center"
                                          Content="Eco mode"
                                          Foreground="{DynamicResource TextBrush}"
                                          IsChecked="{Binding IsEcoModeEnabled, Mode=TwoWay}"
                                          ToolTipService.InitialShowDelay="1000"
                                          ToolTip="Lowers CPU use by slowing UI refresh and spectrum analysis. Best for older PCs or long sessions." />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox VerticalAlignment="Center"
                                          Content="Always on top"
                                          Foreground="{DynamicResource TextBrush}"
                                          IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
                                <CheckBox Margin="14,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="Show hidden"
                                          Foreground="{DynamicResource TextBrush}"
                                          IsChecked="{Binding ShowHiddenSources, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    MinWidth="82"
                                    Height="26"
                                    Command="{Binding ResetAllCommand}"
                                    Content="Reset All" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="12,0,12,8"
                        Padding="10,8"
                        Height="150"
                        Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentEvents}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="94" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="Recent" />
                            <ComboBox Grid.Column="2"
                                      Height="24"
                                      ItemsSource="{Binding RecentEventFilterOptions}"
                                      SelectedItem="{Binding SelectedRecentEventFilter, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DisabledTextBrush}"
                                       FontSize="11"
                                       Text="No matching events">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleRecentEvents}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VisibleRecentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DisabledTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Text="{Binding TimeText}" />
                                            <Border Grid.Column="2"
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="3.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Opacity" Value="0.9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewModels:ReadoutSeverity.Muted}">
                                                                <Setter Property="Background" Value="{DynamicResource DisabledTextBrush}" />
                                                                <Setter Property="Opacity" Value="0.72" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewModels:ReadoutSeverity.Warm}">
                                                                <Setter Property="Background" Value="{DynamicResource WarmBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewModels:ReadoutSeverity.Hot}">
                                                                <Setter Property="Background" Value="#FF8A3D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewModels:ReadoutSeverity.Critical}">
                                                                <Setter Property="Background" Value="#FF6B6B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewModels:ReadoutSeverity.Over}">
                                                                <Setter Property="Background" Value="#FF2D2D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Grid Grid.Column="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding Detail}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="3"
                              Margin="12,0,12,4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8"
                                      AllowDrop="True"
                                      DragOver="SourceRow_OnDragOver"
                                      Drop="SourceRow_OnDrop"
                                      GiveFeedback="SourceRow_OnGiveFeedback">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Height="0"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReorderDropBefore}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                                     To="18"
                                                                                     Duration="0:0:0.10" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="1"
                                                                                     Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                                     To="0"
                                                                                     Duration="0:0:0.10" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="0"
                                                                                     Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border Height="2"
                                                Margin="8,8"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="1" />
                                    </Border>

                                    <Border Grid.Row="1"
                                            Padding="10"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="6"
                                            AllowDrop="True"
                                            DragOver="SourceRow_OnDragOver"
                                            Drop="SourceRow_OnDrop">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Width="14"
                                                       VerticalAlignment="Center"
                                                       Cursor="SizeAll"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource DisabledTextBrush}"
                                                       MouseMove="SourceDragHandle_OnMouseMove"
                                                       Text="::"
                                                       ToolTip="Drag to reorder" />
                                            <Border Grid.Column="2"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource PanelAltBrush}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding SourceKindLabel}" />
                                            </Border>
                                            <Grid Grid.Column="4"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Double click to edit alias"
                                                  MouseLeftButtonDown="SourceTitle_OnMouseLeftButtonDown">
                                                <TextBlock Foreground="{DynamicResource TextBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayTitle}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAliasEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox GotKeyboardFocus="NamingTextBox_OnGotKeyboardFocus"
                                                         KeyDown="AliasEditTextBox_OnKeyDown"
                                                         LostKeyboardFocus="AliasEditTextBox_OnLostKeyboardFocus"
                                                         Text="{Binding AliasEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource NamingTextEditor}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAliasEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                            <Border Grid.Column="6"
                                                    Margin="10,0,0,0"
                                                    MinWidth="74"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#27303A" />
                                                        <Setter Property="BorderBrush" Value="#42505E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Muted}">
                                                                <Setter Property="Background" Value="#222832" />
                                                                <Setter Property="BorderBrush" Value="#313A45" />
                                                                <Setter Property="Opacity" Value="0.68" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Warm}">
                                                                <Setter Property="Background" Value="#4A3B1E" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Hot}">
                                                                <Setter Property="Background" Value="#76351D" />
                                                                <Setter Property="BorderBrush" Value="#FF8A3D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Critical}">
                                                                <Setter Property="Background" Value="#C92A2A" />
                                                                <Setter Property="BorderBrush" Value="#FF6B6B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Over}">
                                                                <Setter Property="Background" Value="#F8FAFC" />
                                                                <Setter Property="BorderBrush" Value="#FF2D2D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding PrimaryValueText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#D7E0EA" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Muted}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Warm}">
                                                                    <Setter Property="Foreground" Value="#FFE8A8" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Hot}">
                                                                    <Setter Property="Foreground" Value="#FFF0E8" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Critical}">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PrimaryValueSeverity}" Value="{x:Static viewModels:ReadoutSeverity.Over}">
                                                                    <Setter Property="Foreground" Value="#B00020" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Height="8"
                                              Margin="0,4,0,0">
                                            <Border Background="{DynamicResource MeterTrackBrush}"
                                                    CornerRadius="4" />
                                            <ProgressBar Maximum="1"
                                                         Value="{Binding DisplayLevel, Mode=OneWay}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>

                                        <StackPanel Grid.Row="2"
                                                    Margin="0,9,0,0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Width="28"
                                                    Height="24"
                                                    Padding="0"
                                                    Command="{Binding DataContext.MoveSourceUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="10"
                                                    Content="&#xE70E;"
                                                    ToolTip="Move up" />
                                            <Button Margin="4,0,0,0"
                                                    Width="28"
                                                    Height="24"
                                                    Padding="0"
                                                    Command="{Binding DataContext.MoveSourceDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="10"
                                                    Content="&#xE70D;"
                                                    ToolTip="Move down" />
                                            <Button Margin="8,0,0,0"
                                                    MinWidth="54"
                                                    Height="24"
                                                    Command="{Binding HideSourceCommand}"
                                                    Content="Hide">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Margin="8,0,0,0"
                                                    MinWidth="64"
                                                    Height="24"
                                                    Command="{Binding RestoreSourceCommand}"
                                                    Content="Restore">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button MinWidth="64"
                                                    Margin="8,0,0,0"
                                                    Height="24"
                                                    Command="{Binding OpenDetailCommand}"
                                                    Content="Details" />
                                            <Button Margin="8,0,0,0"
                                                    MinWidth="64"
                                                    Height="24"
                                                    Command="{Binding OpenPopupCommand}"
                                                    Content="Pop-up" />
                                            <Button Margin="8,0,0,0"
                                                    MinWidth="56"
                                                    Height="24"
                                                    Command="{Binding ResetCommand}"
                                                    Content="Reset" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                    <Border Grid.Row="2"
                                            Height="0"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReorderDropAfter}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                                     To="18"
                                                                                     Duration="0:0:0.10" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="1"
                                                                                     Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                                     To="0"
                                                                                     Duration="0:0:0.10" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="0"
                                                                                     Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border Height="2"
                                                Margin="8,8"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="1" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="4"
                           Margin="14,0,14,8"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           FontSize="10"
                           Text="Per-process LUFS metrics warm up after active audio starts." />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailViewVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Width="72"
                            Height="28"
                            Command="{Binding BackToGlobalCommand}"
                            Content="Back" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="SaveInlineDetailLayoutButton"
                                Margin="0,0,2,0"
                                Style="{StaticResource ChromeIconButton}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Content="&#xE74E;"
                                AutomationProperties.Name="Save detail layout"
                                ToolTip="Save detail layout"
                                Click="SaveInlineDetailLayoutButton_OnClick" />
                        <Button x:Name="LoadInlineDetailLayoutButton"
                                Margin="2,0,12,0"
                                Style="{StaticResource ChromeIconButton}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Content="&#xE8E5;"
                                AutomationProperties.Name="Load detail layout"
                                ToolTip="Load detail layout"
                                Click="LoadInlineDetailLayoutButton_OnClick" />
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="11"
                                   Text="True Peak" />
                        <ComboBox Width="148"
                                  Height="26"
                                  AutomationProperties.Name="True Peak"
                                  ItemsSource="{Binding TruePeakOversamplingOptions}"
                                  SelectedItem="{Binding SelectedDetailSession.TruePeakOversampling, Mode=TwoWay}" />
                        <Button Margin="10,0,0,0"
                                MinWidth="74"
                                Height="26"
                                Command="{Binding ForgetSelectedSourceCommand}"
                                Content="Forget"
                                ToolTip="Forget saved alias and detail settings for this source." />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Grid.RowSpan="2"
                              Margin="0,10,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDetailSession.IsInstanceMissing}" Value="True">
                                    <Setter Property="Opacity" Value="0.38" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="0,0,0,42">
                        <StackPanel Margin="0,0,0,12">
                            <Grid DataContext="{Binding SelectedDetailSession}"
                                  ToolTip="Double click to edit alias"
                                  MouseLeftButtonDown="SourceTitle_OnMouseLeftButtonDown">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding DisplayTitle}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAliasEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox FontSize="16"
                                         FontWeight="SemiBold"
                                         GotKeyboardFocus="NamingTextBox_OnGotKeyboardFocus"
                                         KeyDown="AliasEditTextBox_OnKeyDown"
                                         LostKeyboardFocus="AliasEditTextBox_OnLostKeyboardFocus"
                                         Text="{Binding AliasEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource NamingTextEditor}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAliasEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding SelectedDetailSession.SourceIdentityText}" />
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding SelectedDetailSession.SourceStatusText}" />
                        </StackPanel>

                <StackPanel>
                    <Grid Margin="0,0,0,6">
                    <controls:ScaledLevelMeter Height="46"
                                               Label="{Binding SelectedDetailSession.DetailMomentaryLufsLabel}"
                                               LabelIndent="30"
                                               Level="{Binding SelectedDetailSession.DetailMomentaryLufsLevel, Mode=OneWay}"
                                               ScaleMaximum="0"
                                               ScaleMinimum="-60"
                                               TickValues="-60,-48,-36,-24,-12,0"
                                               ValueText="{Binding SelectedDetailSession.DetailMomentaryLufsText}" />
                        <Border Width="138" Height="28" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Panel.ZIndex="1" Background="Transparent"
                                controls:HoverHintBehavior.IsEnabled="{Binding EnableDetailHoverHints}"
                                controls:HoverHintBehavior.Text="Momentary loudness shows the K-weighted loudness over the latest 400 ms. Mid = (L + R) / 2 and Side = (L - R) / 2." />
                        <ComboBox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Panel.ZIndex="2"
                                  FontSize="10"
                                  Style="{StaticResource SignalMeasurementModeComboBox}"
                                  ItemsSource="{Binding SignalMeasurementModeOptions}"
                                  AutomationProperties.Name="Momentary loudness measurement mode"
                                  SelectedItem="{Binding SelectedDetailSession.MomentaryMeasurementMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                    <controls:ScaledLevelMeter Height="46"
                                               Label="{Binding SelectedDetailSession.DetailShortTermLufsLabel}"
                                               LabelIndent="30"
                                               Level="{Binding SelectedDetailSession.DetailShortTermLufsLevel, Mode=OneWay}"
                                               ScaleMaximum="0"
                                               ScaleMinimum="-60"
                                               TickValues="-60,-48,-36,-24,-12,0"
                                               ValueText="{Binding SelectedDetailSession.DetailShortTermLufsText}" />
                        <Border Width="138" Height="28" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Panel.ZIndex="1" Background="Transparent"
                                controls:HoverHintBehavior.IsEnabled="{Binding EnableDetailHoverHints}"
                                controls:HoverHintBehavior.Text="Short-term loudness averages the selected signal over the latest 3 seconds for a steadier program-level view." />
                        <ComboBox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" FontSize="10"
                                  Style="{StaticResource SignalMeasurementModeComboBox}"
                                  ItemsSource="{Binding SignalMeasurementModeOptions}"
                                  AutomationProperties.Name="Short-term loudness measurement mode"
                                  SelectedItem="{Binding SelectedDetailSession.ShortTermMeasurementMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                    <controls:ScaledLevelMeter Height="46"
                                               Label="{Binding SelectedDetailSession.DetailIntegratedLufsLabel}"
                                               LabelIndent="30"
                                               Level="{Binding SelectedDetailSession.DetailIntegratedLufsLevel, Mode=OneWay}"
                                               ScaleMaximum="0"
                                               ScaleMinimum="-60"
                                               TickValues="-60,-48,-36,-24,-12,0"
                                               ValueText="{Binding SelectedDetailSession.DetailIntegratedLufsText}" />
                        <Border Width="138" Height="28" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Panel.ZIndex="1" Background="Transparent"
                                controls:HoverHintBehavior.IsEnabled="{Binding EnableDetailHoverHints}"
                                controls:HoverHintBehavior.Text="Integrated loudness applies BS.1770-style absolute and relative gating across the selected signal since the last reset." />
                        <ComboBox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" FontSize="10"
                                  Style="{StaticResource SignalMeasurementModeComboBox}"
                                  ItemsSource="{Binding SignalMeasurementModeOptions}"
                                  AutomationProperties.Name="Integrated loudness measurement mode"
                                  SelectedItem="{Binding SelectedDetailSession.IntegratedMeasurementMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                    <controls:ScaledLevelMeter Height="46"
                                               Label="{Binding SelectedDetailSession.DetailTruePeakLabel}"
                                               LabelIndent="30"
                                               Level="{Binding SelectedDetailSession.DetailTruePeakLevel, Mode=OneWay}"
                                               ScaleMaximum="3"
                                               ScaleMinimum="-60"
                                               TickValues="-60,-48,-36,-24,-12,0,+3"
                                               ValueSeverity="{Binding SelectedDetailSession.DetailTruePeakReadoutSeverity}"
                                               ValueSubtext="{Binding SelectedDetailSession.DetailTruePeakMaxText}"
                                               ValueText="{Binding SelectedDetailSession.DetailTruePeakText}" />
                        <Border Width="138" Height="28" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Panel.ZIndex="1" Background="Transparent"
                                controls:HoverHintBehavior.IsEnabled="{Binding EnableDetailHoverHints}"
                                controls:HoverHintBehavior.Text="True peak estimates inter-sample peaks over the latest 100 ms. The max readout holds the highest selected-signal value until reset." />
                        <ComboBox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" FontSize="10"
                                  Style="{StaticResource SignalMeasurementModeComboBox}"
                                  ItemsSource="{Binding SignalMeasurementModeOptions}"
                                  AutomationProperties.Name="True-peak level measurement mode"
                                  SelectedItem="{Binding SelectedDetailSession.TruePeakMeasurementMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                    <controls:ScaledLevelMeter Height="46"
                                               Label="{Binding SelectedDetailSession.DetailRms100MsLabel}"
                                               LabelIndent="30"
                                               Level="{Binding SelectedDetailSession.DetailRms100MsLevel, Mode=OneWay}"
                                               ScaleMaximum="0"
                                               ScaleMinimum="-60"
                                               TickValues="-60,-48,-36,-24,-12,0"
                                               ValueText="{Binding SelectedDetailSession.DetailRms100MsText}" />
                        <Border Width="138" Height="28" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Panel.ZIndex="1" Background="Transparent"
                                controls:HoverHintBehavior.IsEnabled="{Binding EnableDetailHoverHints}"
                                controls:HoverHintBehavior.Text="100 ms RMS shows the recent average signal energy. Use Mid to inspect centered content and Side to inspect stereo difference content." />
                        <ComboBox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" FontSize="10"
                                  Style="{StaticResource SignalMeasurementModeComboBox}"
                                  ItemsSource="{Binding SignalMeasurementModeOptions}"
                                  AutomationProperties.Name="100 ms RMS level measurement mode"
                                  SelectedItem="{Binding SelectedDetailSession.RmsMeasurementMode, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <Popup x:Name="CollisionSettingsPopup"
                       AllowsTransparency="True"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=CollisionSettingsButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False">
                    <Border MinWidth="230"
                            Padding="10"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="11"
                                           Text="Scale" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="11"
                                           Text="{Binding CollisionFrequencyScaleText}" />
                            </Grid>
                            <ComboBox Margin="0,3,0,10"
                                      Height="26"
                                      AutomationProperties.Name="Scale"
                                      ItemsSource="{Binding CollisionFrequencyScaleOptions}"
                                      SelectedItem="{Binding CollisionFrequencyScale, Mode=TwoWay}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="11"
                                           Text="Level floor" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="11"
                                           Text="{Binding CollisionLevelFloorText}" />
                            </Grid>
                            <controls:EditableValueSlider Minimum="-200"
                                                          Maximum="0"
                                                          Step="1"
                                                          DisplayFormat="0"
                                                          DisplaySuffix=" dB"
                                                          ToolTipService.InitialShowDelay="1000"
                                                          ToolTip="Ignores frequency bins unless both the focused source and comparison source are at or above this level."
                                                          AutomationProperties.Name="Level floor"
                                                          Value="{Binding CollisionLevelFloorDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="11"
                                           Text="Prominence" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="11"
                                           Text="{Binding CollisionProminenceThresholdText}" />
                            </Grid>
                            <controls:EditableValueSlider Minimum="0"
                                                          Maximum="24"
                                                          Step="1"
                                                          DisplayFormat="0"
                                                          DisplaySuffix=" dB"
                                                          ToolTipService.InitialShowDelay="1000"
                                                          ToolTip="Requires both sources to rise above their nearby spectrum background before a frequency is treated as a collision."
                                                          AutomationProperties.Name="Prominence"
                                                          Value="{Binding CollisionProminenceThresholdDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="11"
                                           Text="Match tolerance" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="11"
                                           Text="{Binding CollisionRelativeThresholdText}" />
                            </Grid>
                            <controls:EditableValueSlider Minimum="0.02"
                                                          Maximum="0.8"
                                                          Step="0.02"
                                                          DisplayScale="100"
                                                          DisplayFormat="0"
                                                          DisplaySuffix="%"
                                                          ToolTipService.InitialShowDelay="1000"
                                                          ToolTip="Maximum normalized level difference allowed between two prominent frequency bins."
                                                          AutomationProperties.Name="Match tolerance"
                                                          Value="{Binding CollisionRelativeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="InlineClockSettingsPopup"
                       AllowsTransparency="True"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=InlineClockSettingsButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False">
                    <Border MinWidth="286"
                            Padding="10"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Text="Range" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="11" Text="{Binding LoudnessClockRangeText}" />
                            </Grid>
                            <controls:DbRangeSlider Margin="0,2,0,0"
                                                    Minimum="-120"
                                                    Maximum="0"
                                                    Step="1"
                                                    AutomationProperties.Name="Range"
                                                    LowerValue="{Binding LoudnessClockMinimumDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    UpperValue="{Binding LoudnessClockMaximumDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Text="Warning" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="11" Text="{Binding LoudnessClockWarningText}" />
                            </Grid>
                            <controls:EditableValueSlider Minimum="-120"
                                                          Maximum="0"
                                                          Step="1"
                                                          DisplayFormat="0"
                                                          DisplaySuffix=" LUFS"
                                                          AutomationProperties.Name="Warning"
                                                          Value="{Binding LoudnessClockWarningDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Text="Cycle" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="11" Text="{Binding LoudnessClockCycleText}" />
                            </Grid>
                            <controls:EditableValueSlider Minimum="10"
                                                          Maximum="600"
                                                          Step="5"
                                                          DisplayFormat="0"
                                                          DisplaySuffix=" s"
                                                          AutomationProperties.Name="Cycle"
                                                          Value="{Binding LoudnessClockCycleSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="InlineWaveformSettingsPopup"
                       AllowsTransparency="True"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=InlineWaveformSettingsButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False">
                    <Border MinWidth="180"
                            Padding="10"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ComboBox Width="128"
                                  Height="26"
                                  AutomationProperties.Name="Waveform display mode"
                                  ItemsSource="{Binding WaveformDisplayModeOptions}"
                                  SelectedItem="{Binding SelectedDetailSession.WaveformDisplayMode, Mode=TwoWay}" />
                    </Border>
                </Popup>

                <Popup x:Name="InlineSpectrumSettingsPopup"
                       AllowsTransparency="True"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=InlineSpectrumSettingsButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False">
                    <Border MinWidth="286"
                            Padding="10"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <ComboBox Width="128"
                                      Height="26"
                                      AutomationProperties.Name="Spectrum display mode"
                                      ItemsSource="{Binding SpectrumDisplayModeOptions}"
                                      SelectedItem="{Binding SelectedDetailSession.SpectrumDisplayMode, Mode=TwoWay}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Text="Range" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontSize="11" Text="{Binding SpectrumDisplayRangeText}" />
                            </Grid>
                            <controls:DbRangeSlider Margin="0,2,0,0"
                                                    Minimum="-200"
                                                    Maximum="0"
                                                    Step="1"
                                                    AutomationProperties.Name="Range"
                                                    LowerValue="{Binding SpectrumDisplayFloorDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    UpperValue="{Binding SpectrumDisplayCeilingDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="{Binding InlineStereoModule.OrderIndex}"
                                Margin="0,0,0,8"
                                Tag="{Binding InlineStereoModule}"
                                AllowDrop="True"
                                 PreviewDragOver="InlineDetailModule_OnDragOver"
                                 PreviewDrop="InlineDetailModule_OnDrop"
                                GiveFeedback="InlineDetailModule_OnGiveFeedback">
                        <Border Style="{StaticResource DetailModuleDropBeforeHint}">
                            <Border Height="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="1" />
                        </Border>
                        <Border x:Name="InlineStereoPanel"
                                Height="{Binding InlineStereoModule.DisplayHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MinHeight="{Binding InlineStereoModule.DisplayMinimumHeight}"
                                MaxHeight="900"
                                Padding="10"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
