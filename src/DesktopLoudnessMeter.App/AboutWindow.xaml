<Window x:Class="DesktopLoudnessMeter.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About uMeter"
        Icon="Assets/desktop-loudness-meter.ico"
        Width="480"
        Height="510"
        MinWidth="440"
        MinHeight="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppChromeBrush}"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,0,8,0"
                    Background="{DynamicResource AppChromeBrush}"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="About uMeter" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Information about uMeter and its collaborators" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ChromeIconButton}"
                            Click="CloseButton_OnClick"
                            Content="X"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="64"
                           Height="64"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Source="Assets/desktop-loudness-meter.png" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="uMeter" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding VersionText}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Made by Campfireman Studio" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           FontSize="11"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="Per-source desktop loudness metering with WASAPI and sender-plugin support."
                           TextWrapping="Wrap" />

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Text="Collaborators" />
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Credits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Text="{Binding Role}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Height="30"
                            MinWidth="152"
                            Padding="12,0"
                            Click="RepositoryButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE71B;" />
                            <TextBlock VerticalAlignment="Center" Text="Project repository" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Width="72"
                            Height="30"
                            Click="CloseButton_OnClick"
                            Content="Close" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
